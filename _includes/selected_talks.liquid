<!-- Selected talks include for homepage -->
{% assign recent_talks = site.data.talks | sort: "sort_date" | reverse | slice: 0, 3 %}

<div class="selected-talks">
  {% for talk in recent_talks %}
    <div class="talk-item">
      <p>
        {% assign talk_date = talk.sort_date | date: "%s" %}
        {% assign current_date = "now" | date: "%s" %}
        {% assign is_upcoming = talk_date > current_date %}
        {{ talk.date }}.{% if talk.title %} {% if talk.slides %}<a href="{{ talk.slides }}" target="_blank"><strong>{{ talk.title }}</strong></a>{% else %}<strong>{{ talk.title }}</strong>{% endif %}{% endif %}{% if is_upcoming %} <em>(upcoming)</em>{% endif %}{% if talk.venue %}. {% if is_upcoming %}To be held at{% else %}Held at{% endif %} <em>{{ talk.venue }}</em>{% if talk.location %} in {{ talk.location }}{% endif %}{% endif %}.
      </p>
    </div>
  {% endfor %}
</div>
