<!-- Selected talks include for homepage -->
{% assign recent_talks = site.data.talks | sort: 'sort_date' | reverse | slice: 0, 3 %}

<div class="selected-talks">
  {% for talk in recent_talks %}
    <div class="talk-item">
      <p>
        {{ talk.date }}.
        {%- if talk.title %}
          {% if talk.slides -%}
            <a href="{{ talk.slides }}" target="_blank"
              ><strong>{{ talk.title }}</strong></a
            >
          {%- else -%}
            <strong>{{ talk.title }}</strong>
          {%- endif -%}
        {%- endif -%}
        {%- if talk.label %}
          <span class="talk-label">{{ talk.label }}</span>
        {%- endif -%}
        {%- if talk.status == 'upcoming' %}
          <em>(upcoming)</em>
        {%- endif -%}
        {%- if talk.venue -%}
          . {% if talk.status == 'upcoming' %}To be held at{% else %}Held at{% endif %}
          <em>{{ talk.venue }}</em>
          {%- if talk.location %} in {{ talk.location }}{% endif -%}
        {%- endif -%}
        .
      </p>
    </div>
  {% endfor %}
</div>
