<!-- Selected talks include for homepage -->
{% assign recent_talks = site.data.talks | sort: "sort_date" | reverse | slice: 0, 3 %}

<div class="selected-talks">
  {% for talk in recent_talks %}
    <div class="talk-item">
      <p>
        {{ talk.date }}. 
        {% if talk.title %}
          {% if talk.slides %}
            <a href="{{ talk.slides }}" target="_blank" style="color: var(--global-theme-color);">{{ talk.title }}</a>
          {% else %}
            <span style="color: var(--global-theme-color);">{{ talk.title }}</span>
          {% endif %}
        {% endif %}
        {% if talk.venue %}
          . Held at <em>{{ talk.venue }}</em>{% if talk.location %} in {{ talk.location }}{% endif %}
        {% endif %}.
      </p>
    </div>
  {% endfor %}
</div>
